@model IEnumerable<CarRental.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    ViewData["ActivePage"] = "Bookings";
    var bookings = Model ?? Enumerable.Empty<CarRental.Models.Booking>();
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
}

<h2>@(isAdmin ? "All Bookings" : "My Bookings")</h2>

@if (!bookings.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Car</th>
                    <th>Customer</th>
                    <th>Pickup</th>
                    <th>Return</th>
                    <th>Days</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>@b.Car.Make @b.Car.Model</td>
                        <td>@b.User.FullName</td>
                        <td>@b.PickupDate.ToShortDateString()</td>
                        <td>@b.ReturnDate.ToShortDateString()</td>
                        <td>@b.Days</td>
                        <td>@b.TotalPrice.ToString("C")</td>
                        <td>
                            <span class="badge bg-@(b.Status switch { "Confirmed" => "success", "Pending" => "warning", "Cancelled" => "danger", _ => "secondary" })">
                                @b.Status
                            </span>
                        </td>
                        <td class="table-actions">
                            @if (b.Status == "Pending")
                            {
                                <form asp-area="" asp-controller="Bookings" asp-action="Cancel" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this booking?')">Cancel</button>
                                </form>
                            }
                            @if (isAdmin)
                            {
                                <form asp-area="" asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <select name="status" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                        <option value="Pending" selected="@(b.Status == "Pending" ? "selected" : null)">Pending</option>
                                        <option value="Confirmed" selected="@(b.Status == "Confirmed" ? "selected" : null)">Confirmed</option>
                                        <option value="Cancelled" selected="@(b.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                                    </select>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

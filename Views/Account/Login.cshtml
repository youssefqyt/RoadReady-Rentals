@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-area="" asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] as string ?? string.Empty)" />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
        <p class="mt-3">Don't have an account? <a asp-area="" asp-controller="Account" asp-action="Register">Register here</a>.</p>
        @if (!string.IsNullOrEmpty(ViewData["ReturnUrl"] as string))
        {
            <p class="text-muted small">You will be redirected to your requested page after login.</p>
        }
    </div>
</div>

@model IEnumerable<CarRental.Models.Car>

@{
    ViewData["Title"] = "Manage Cars";
}

<h2>Manage Cars</h2>
<a asp-area="" asp-controller="Cars" asp-action="Create" class="btn btn-primary mb-3">+ Add Car</a>
<a asp-area="" asp-controller="Cars" asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Catalog</a>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Car</th>
                <th>Category</th>
                <th>Price/Day</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><img src="@c.ImageUrl" alt="@c.Make" class="img-thumbnail" style="width:60px;height:40px;object-fit:cover;" /></td>
                    <td>@c.Make @c.Model (@c.Year)</td>
                    <td>@c.Category</td>
                    <td>@c.PricePerDay.ToString("C")</td>
                    <td>@(c.IsAvailable ? "<span class='badge bg-success'>Yes</span>" : "<span class='badge bg-danger'>No</span>")</td>
                    <td>
                        <a asp-area="" asp-controller="Cars" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-area="" asp-controller="Cars" asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this car?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

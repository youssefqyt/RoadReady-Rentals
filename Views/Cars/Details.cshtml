@model CarRental.Models.Car

@{
    ViewData["Title"] = Model.Make + " " + Model.Model;
}

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" alt="@Model.Make @Model.Model" class="img-fluid rounded shadow-sm" />
    </div>
    <div class="col-md-6">
        <h2>@Model.Make @Model.Model (@Model.Year)</h2>
        <span class="badge bg-dark text-white mb-2">@Model.Category</span>
        <p class="mt-3">@Model.Description</p>
        <ul class="list-group list-group-flush mb-3">
            <li class="list-group-item d-flex justify-content-between"><strong>Price per day</strong><span class="price-tag">@Model.PricePerDay.ToString("C")</span></li>
            <li class="list-group-item d-flex justify-content-between"><strong>Seats</strong>@Model.Seats</li>
            <li class="list-group-item d-flex justify-content-between"><strong>Transmission</strong>@Model.Transmission</li>
            <li class="list-group-item d-flex justify-content-between"><strong>Fuel type</strong>@Model.FuelType</li>
            <li class="list-group-item d-flex justify-content-between"><strong>Status</strong><span class="badge bg-@(Model.IsAvailable ? "success" : "danger")">@(Model.IsAvailable ? "Available" : "Unavailable")</span></li>
        </ul>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer") && Model.IsAvailable)
        {
            <a asp-area="" asp-controller="Bookings" asp-action="Create" asp-route-carId="@Model.Id" class="btn btn-primary btn-lg">Book Now</a>
        }
        else if (!User.Identity?.IsAuthenticated == true)
        {
            <p class="text-muted">Please <a asp-area="" asp-controller="Account" asp-action="Login">log in</a> to book this car.</p>
        }
    </div>
</div>

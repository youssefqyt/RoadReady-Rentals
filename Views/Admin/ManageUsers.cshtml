@model IEnumerable<CarRental.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<h2>Manage Users</h2>
<a asp-area="" asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary mb-3">Back to Dashboard</a>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Phone</th>
                <th>License #</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td><span class="badge bg-@(u.Role == "Admin" ? "danger" : "primary")">@u.Role</span></td>
                    <td>@u.Phone ?? "-"</td>
                    <td>@u.DrivingLicenseNumber ?? "-"</td>
                    <td>@u.CreatedAt.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
</div>

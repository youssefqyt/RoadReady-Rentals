@{
    ViewData["Title"] = "Register";
}

<h2>Create Account</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-area="" asp-controller="Account" asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required minlength="8" />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone (optional)</label>
                <input type="tel" name="phone" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Driving License Number (optional)</label>
                <input type="text" name="drivingLicense" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
        <p class="mt-3">Already have an account? <a asp-area="" asp-controller="Account" asp-action="Login">Login here</a>.</p>
    </div>
</div>

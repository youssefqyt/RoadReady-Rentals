@{
    ViewData["Title"] = "Home";
    ViewData["ActivePage"] = "Cars";
    var cars = Model as IEnumerable<CarRental.Models.Car> ?? Enumerable.Empty<CarRental.Models.Car>();
}

<section class="hero text-center mb-4">
    <div class="container">
        <h1 class="display-4 mb-3">DriveEase Car Rental</h1>
        <p class="lead mb-0">Rent your dream car with flexible plans and instant booking.</p>
    </div>
</section>

<div class="container">
    <div class="filter-card card bg-light p-3 mb-4">
        <h5>Find Your Ride</h5>
        <form asp-area="" asp-controller="Cars" asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label visually-hidden">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Make or model" value="@ViewData["Search"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label visually-hidden">Category</label>
                <select name="category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var cat in Enum.GetValues<CarRental.Models.CarCategory>())
                    {
                        var selected = ViewData["Category"]?.ToString() == cat.ToString() ? "selected" : null;
                        <option value="@cat" selected="@selected">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label visually-hidden">Max price/day</label>
                <input type="number" name="maxPrice" class="form-control" placeholder="Max price" value="@ViewData["MaxPrice"]" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>

    <h2 class="mb-3">Available Cars</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var car in cars)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-img-wrapper position-relative">
                        <img src="@car.ImageUrl" alt="@car.Make @car.Model" />
                        <span class="badge bg-@(car.IsAvailable ? "success" : "secondary") position-absolute top-0 end-0 m-2">
                            @(car.IsAvailable ? "Available" : "Unavailable")
                        </span>
                        <span class="category-badge badge bg-dark text-white position-absolute top-0 start-0 m-2">
                            @car.Category
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@car.Make @car.Model (@car.Year)</h5>
                        <p class="card-text flex-grow-1">@car.Description</p>
                        <div class="d-flex justify-content-between align-items-start mt-auto">
                            <div>
                                <div class="price-tag">@car.PricePerDay.ToString("C") / day</div>
                                <div class="text-muted small">@car.Seats seats · @car.Transmission · @car.FuelType</div>
                            </div>
                            <a asp-area="" asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Highlight active nav based on current path
    </script>
}
